// Cloudflare Workers configuration for the Naadan Frenzy multiplayer server.
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "naadan-frenzy-server",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // The game engine is imported as the bare module "naadan-core" (see src/engine.js).
  // This alias points it at the same core.js the browser game loads, in the repo root.
  "alias": {
    "naadan-core": "../core.js"
  },

  // One Durable Object instance per room code (idFromName(CODE)).
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },

  // SQLite-backed Durable Objects are required on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  "vars": {
    // How long a disconnected player keeps their slot (ms). Tests shorten this.
    "GRACE_MS": "60000"
  },

  "observability": { "enabled": true }
}
