// Test/dev configuration: identical to wrangler.jsonc except that the engine
// alias points at the mock engine and the Worker has a different name, so an
// accidental `wrangler deploy -c wrangler.mock.jsonc` can never replace the
// production Worker. Used by `npm run dev:mock` and `npm test`.
// (wrangler dev ignores the --alias CLI flag, hence a second config file.)
// test/clients.mjs checks that bindings/migrations still match wrangler.jsonc.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "naadan-frenzy-server-mock",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "alias": {
    "naadan-core": "./test/mock-core.js"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    "GRACE_MS": "60000"
  },
  "observability": { "enabled": true }
}
